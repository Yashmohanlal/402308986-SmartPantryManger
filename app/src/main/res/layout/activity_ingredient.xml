<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_ingredient_2_text" android:textSize="28sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
        <TextView android:id="@+id/formHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_ingredient_3_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/name" android:text="@string/activity_ingredient_4_text" />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/activity_ingredient_5_hint" android:inputType="textCapWords" android:maxLength="60" android:singleLine="true" android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/quantity" android:text="@string/activity_ingredient_6_text" />
        <EditText android:id="@+id/quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/activity_ingredient_7_hint" android:inputType="numberDecimal" android:maxLength="60" android:singleLine="true" android:importantForAutofill="no" />
        <TextView android:id="@+id/unitLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_ingredient_8_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
        <Spinner android:id="@+id/unit" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/activity_ingredient_9_contentdescription" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/expiry" android:text="@string/activity_ingredient_10_text" />
        <EditText android:id="@+id/expiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/activity_ingredient_11_hint" android:inputType="date" android:singleLine="true" android:maxLength="10" android:importantForAutofill="no" />
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/activity_ingredient_12_text" android:textAllCaps="false" />
        <Button android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/activity_ingredient_13_text" android:textAllCaps="false" />
        <Button android:id="@+id/cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/activity_ingredient_14_text" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>