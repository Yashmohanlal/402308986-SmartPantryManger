<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_recipes_1_text" android:textSize="28sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
    <TextView android:id="@+id/recipeHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_recipes_2_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
    <Switch android:id="@+id/showAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/activity_recipes_3_text" />
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_recipes_4_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:dividerHeight="8dp" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_recipes_6_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
    </FrameLayout>
    <include layout="@layout/navigation" />
</LinearLayout>