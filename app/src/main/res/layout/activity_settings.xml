<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_settings_3_text" android:textSize="28sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
            <Switch android:id="@+id/expiryAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/activity_settings_4_text" />
            <TextView android:id="@+id/settingsHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_settings_5_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
            <TextView android:id="@+id/matchingHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_settings_6_text" android:textSize="22sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
            <TextView android:id="@+id/matchingHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_settings_7_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
            <TextView android:id="@+id/aboutHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_settings_8_text" android:textSize="22sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
            <TextView android:id="@+id/about" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_settings_9_text" android:textSize="16sp" android:textColor="#183A2B" android:paddingBottom="12dp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/navigation" />
</LinearLayout>